# GoCardless Bank Account Data credentials (free tier)
# Get them at https://bankaccountdata.gocardless.com -> User secrets.
# Copy this file to sync/.env (which is gitignored) and fill in real values.
GC_SECRET_ID=your-secret-id-here
GC_SECRET_KEY=your-secret-key-here

# Institution to link. Start with the sandbox (fake data, no rate limits),
# then switch to the real bank and run "link" again.
# Sandbox:   SANDBOXFINANCE_SFIN0000
# Real bank: leave empty to search interactively for UniCredit/buddybank.
GC_INSTITUTION_ID=SANDBOXFINANCE_SFIN0000

# Country for institution search (used when GC_INSTITUTION_ID is empty).
GC_COUNTRY=it

# Where the bank redirects the browser after you authorize. Cosmetic — the
# consent is already granted by then. Set it to your deployed app URL if you like.
GC_REDIRECT_URL=http://localhost:8123/?bank-linked=1
